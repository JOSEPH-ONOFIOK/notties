# ── Database ───────────────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset locally: the app runs an embedded Postgres (PGlite) in .data/pglite.
# In production set a Postgres URL (Neon, Supabase, Railway…). Tables are created on first start.
DATABASE_URL=
# Set to "false" only if your Postgres host doesn't speak TLS (local docker, etc).
DATABASE_SSL=

# ── Sign in with X (OAuth 2.0) ─────────────────────────────────────────────────────────────
# X developer portal → your app → User authentication settings: OAuth 2.0 on, type "Web App",
# callback URLs: https://<your-domain>/api/x/callback and http://localhost:3000/api/x/callback
# Without these, local dev can still sign in via http://localhost:3000/api/dev/login?u=anyname
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs session cookies. Any long random string: `openssl rand -hex 32`
SESSION_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────────────────────
# Comma-separated X usernames who get /admin when signed in (no @ needed).
ADMIN_X_USERNAMES=
# Or a shared secret: open /api/admin/key?key=<ADMIN_KEY> once to get an admin cookie.
ADMIN_KEY=

# ── Site ───────────────────────────────────────────────────────────────────────────────────
# Public URL, used for referral links and link previews. On Vercel, leave empty to use the host.
NEXT_PUBLIC_SITE_URL=

# ── Bot checks (Cloudflare Turnstile) ──────────────────────────────────────────────────────
# Free at dash.cloudflare.com → Turnstile. Add your domain, copy both keys. Leave empty to turn
# the checks off (local dev). Used on guest sign-in, crate claims and bonus crates.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
